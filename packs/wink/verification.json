    {
      "id": "wink/palette-literals",
      "item": "rule/W-R2",
      "title": "Colours come from the wink palette only",
      "classification": "PARTIALLY_VERIFIABLE",
      "severity": "warning",
      "mode": "STATIC",
      "files": [
        "app.css"
      ],
      "assertions": [
        {
          "relation": "color_literals",
          "allow": [
            "#ffe01b",
            "#241c15",
            "#231e15",
            "#f6f6f4",
            "#dedddc",
            "#e7b75f",
            "#007c89",
            "#bf4055",
            "#ffffff",
            "#fff",
            "#3a322a",
            "#5d5245"
          ],
          "allow_rgb": [
            "35, 30, 21",
            "191, 64, 85",
            "36, 28, 21",
            "243, 199, 207",
            "231, 183, 95",
            "0, 0, 0, 0"
          ],
          "exclude_line_regex": "marks-on|mark-toggle|prov-|mk-"
        }
      ],
      "note": "Allowlist = the six tokens plus ink-family shades the authority's own renders use (#3a322a, #5d5245) — shades beyond the tokens are recorded as a tightening candidate. Catches unsupported hues (greens, etc.)."
    },
    {
