      "title": "Buttons are pills (radius = half height)",
      "classification": "MECHANICALLY_VERIFIABLE",
      "severity": "error",
      "mode": "COMPUTED_STYLE",
      "selector": ".cta",
      "assertions": [
        {
          "property": "border-radius",
          "relation": "pill"
        }
      ],
      "missing": "fail"
    },
