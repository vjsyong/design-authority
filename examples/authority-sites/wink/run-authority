#!/usr/bin/env python3
"""Audited authority runner for the wink site build.

Every authority call goes through here: it runs the real CLI against
packs/wink, appends the call + output to audit.jsonl (machine-recorded
trace). Only this route may be used.
"""
import json, os, subprocess, sys, time

ROOT = "/home/xrim/design-authority"
WS = os.path.dirname(os.path.abspath(__file__))
cmd = [os.path.join(ROOT, ".venv/bin/python3"), os.path.join(ROOT, "tools/da.py"),
       "--pack", os.path.join(ROOT, "packs/wink")] + sys.argv[1:]
t0 = time.time()
proc = subprocess.run(cmd, capture_output=True, text=True, cwd=WS)
rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
       "argv": sys.argv[1:], "rc": proc.returncode,
       "ms": round((time.time() - t0) * 1000),
       "stdout": proc.stdout[-6000:], "stderr": proc.stderr[-2000:]}
with open(os.path.join(WS, "audit.jsonl"), "a") as fh:
    fh.write(json.dumps(rec) + "\n")
sys.stdout.write(proc.stdout)
sys.stderr.write(proc.stderr)
sys.exit(proc.returncode)
