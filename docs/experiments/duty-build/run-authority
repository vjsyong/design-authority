#!/usr/bin/env python3
"""Audited authority runner for the Duty build trace.

Every authority call from the building agent goes through here. The wrapper
runs the real CLI (repo venv) and appends the call + output to audit.jsonl,
so the trace is machine-recorded, not self-reported.

    ./run-authority resolve "a data table" --json
"""
import json
import os
import subprocess
import sys
import time

ROOT = "/home/xrim/design-authority"
WS = os.path.dirname(os.path.abspath(__file__))
argv = [os.path.join(ROOT, ".venv", "bin", "python3"),
        os.path.join(ROOT, "tools", "da.py")] + sys.argv[1:]
t0 = time.time()
proc = subprocess.run(argv, capture_output=True, text=True, cwd=WS)
rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
       "argv": sys.argv[1:],
       "rc": proc.returncode,
       "ms": round((time.time() - t0) * 1000),
       "stdout": proc.stdout[-6000:],
       "stderr": proc.stderr[-2000:]}
with open(os.path.join(WS, "audit.jsonl"), "a") as fh:
    fh.write(json.dumps(rec) + "\n")
sys.stdout.write(proc.stdout)
sys.stderr.write(proc.stderr)
sys.exit(proc.returncode)
