{
  "_note": "Per-authority visual themes for the gallery/authority sites. Values are traced to each authority's own records (token-set artifacts) and to the authority-faithful build archives; see _sources per theme. 'triage' has no entry: the base look IS triage's. Injected as CSS variable overrides over the shared shell.",
  "wink": {
    "_sources": [
      "pack wink token-set/colour + type-scale",
      "examples/cadence3-wink/app.css :root (W-01..W-07)"
    ],
    "vars": {
      "--bg": "#ffffff",
      "--card": "#ffffff",
      "--card2": "#F6F6F4",
      "--line": "#DEDDDC",
      "--line2": "#CBCAC9",
      "--hover": "#F6F6F4",
      "--active": "#F0EFED",
      "--fg": "#241C15",
      "--dim": "#5D5245",
      "--fg-soft": "#3E3730",
      "--acc": "#007C89",
      "--acc-ink": "#007C89",
      "--tint-acc": "#E6F4F5",
      "--ok": "#04713F",
      "--warn": "#B26A00",
      "--err": "#BF4055",
      "--panel": "#241C15",
      "--on-ink": "#ffffff",
      "--focus": "rgba(0,124,137,0.35)",
      "--font-sans": "'Inter', -apple-system, system-ui, sans-serif"
    },
    "head_font": "'Fraunces', Georgia, serif",
    "faces": [
      {
        "family": "Inter",
        "file": "Inter-VF.ttf",
        "dir": "docs/synthesis/wink/tile/fonts",
        "weight": "100 900",
        "style": "normal"
      },
      {
        "family": "Fraunces",
        "file": "Fraunces-VF.ttf",
        "dir": "docs/synthesis/wink/tile/fonts",
        "weight": "100 900",
        "style": "normal"
      },
      {
        "family": "Fraunces",
        "file": "Fraunces-Italic-VF.ttf",
        "dir": "docs/synthesis/wink/tile/fonts",
        "weight": "100 900",
        "style": "italic"
      }
    ],
    "extra_css": ".brand-mark{background:#FFE01B;color:#241C15}.card{border-radius:12px}.btn{border-radius:999px}.gal-chip{border-radius:999px}.btn.primary{background:#FFE01B;border-color:#FFE01B;color:#241C15}"
